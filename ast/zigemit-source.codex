Chapter: Foreword--Sort

 In-place quicksort with median-of-three pivot selection. Sorts the
 input list using list-set-at mutation, allocating nothing beyond the
 input array. The comparator returns a negative, zero, or positive
 integer. Average O n log n time, O log n stack.
 A SortPartition is a record containing the array after partitioning and the final index of the pivot element.
 To sort-by gives the sorted list using the given comparator.

 We say:

Section: Entry Point
  sort-by : List a, (a, a -> Integer) -> List a
  sort-by (xs) (cmp) =
   let len = list-length xs
   in if len <= 1 then xs
   else qsort-by xs cmp 0 (len - 1)

Section: Quicksort
  SortPartition = record { list : List a, pivot : Integer }

  qsort-by : List a, (a, a -> Integer), Integer, Integer -> List a
  qsort-by (xs) (cmp) (lo) (hi) =
   if lo >= hi then xs
   else let xs2 = sort-med3 xs cmp lo (lo + (hi - lo) / 2) hi
   in let pr = sort-partition xs2 cmp lo hi lo (list-at xs2 hi)
   in let xs3 = qsort-by (pr.list) cmp lo (pr.pivot - 1)
   in qsort-by xs3 cmp (pr.pivot + 1) hi

  sort-med3 : List a, (a, a -> Integer), Integer, Integer, Integer -> List a
  sort-med3 (xs) (cmp) (a) (b) (c) =
   let va = list-at xs a
   in let vb = list-at xs b
   in let vc = list-at xs c
   in if cmp va vb <= 0
      then if cmp vb vc <= 0 then sort-swap xs b c
           else if cmp va vc <= 0 then xs
           else sort-swap xs a c
      else if cmp va vc <= 0 then sort-swap xs a c
           else if cmp vb vc <= 0 then xs
           else sort-swap xs b c

  sort-swap : List a, Integer, Integer -> List a
  sort-swap (xs) (i) (j) =
   if i == j then xs
   else let vi = list-at xs i
   in list-set-at (list-set-at xs i (list-at xs j)) j vi

  sort-partition : List a, (a, a -> Integer), Integer, Integer, Integer, a -> SortPartition
  sort-partition (xs) (cmp) (j) (hi) (i) (pv) =
   if j >= hi
   then let xs2 = sort-swap xs i hi
   in SortPartition { list = xs2, pivot = i }
   else if cmp (list-at xs j) pv < 0
      then sort-partition (sort-swap xs i j) cmp (j + 1) hi (i + 1) pv
      else sort-partition xs cmp (j + 1) hi i pv


Chapter: Zig--Name

Section: Types
  Name = record {
   value : Text
  }

Section: Functions
  make-name : Text -> Name
  make-name (s) =
   Name { value = s }

  name-value : Name -> Text
  name-value (n) =
   n.value

Section: Entry Point
  opening-entry-point : Text = "opening"

Page 1



Chapter: Zig--Source Text

Section: Provenance
  Provenance =
   | ProvParsed
   | ProvDesugared
   | ProvSynthetic

Section: Types
  SourcePosition = record {
   line : Integer between 0 and 131071,
   column : Integer between 0 and 4294967295,
   offset : Integer between 0 and 4294967295
  }

  SourceSpan = record {
   start : SourcePosition,
   end : SourcePosition,
   file-id : Integer between 0 and 65535,
   provenance : Provenance
  }

  FileTable = record {
   names : List Text
  }

Section: File Table
  empty-file-table : FileTable
  empty-file-table =
   FileTable {
    names = []
   }

  file-table-add : FileTable, Text -> FileTable
  file-table-add (table) (name) =
   FileTable {
    names = list-push (table.names) name
   }

  file-table-name : FileTable, Integer -> Text
  file-table-name (table) (id) =
   if id <= 0 then ""
   else if id > list-length (table.names) then ""
   else list-at (table.names) (id - 1)

  file-table-count : FileTable -> Integer
  file-table-count (table) =
   list-length (table.names)

Section: Positions and Spans
  make-position : Integer between 0 and 131071, Integer between 0 and 4294967295, Integer between 0 and 4294967295 -> SourcePosition
  make-position (line) (col) (offset) =
   deck-record (SourcePosition {
    line = line,
    column = col,
    offset = offset
   })

  make-span : SourcePosition, SourcePosition, Integer between 0 and 65535, Provenance -> SourceSpan
  make-span (s) (e) (fid) (prov) =
   deck-record (SourceSpan {
    start = s,
    end = e,
    file-id = fid,
    provenance = prov
   })

  span-length : SourceSpan -> Integer
  span-length (span) =
   span.end.offset - span.start.offset

  synthetic-span : SourceSpan
  synthetic-span =
   SourceSpan {
    start = SourcePosition { line = 0, column = 0, offset = 0 },
    end = SourcePosition { line = 0, column = 0, offset = 0 },
    file-id = 0,
    provenance = ProvSynthetic
   }

  is-synthetic-span : SourceSpan -> Boolean
  is-synthetic-span (span) =
   span.file-id == 0

  span-at : Integer between 0 and 131071, Integer between 0 and 4294967295, Integer between 0 and 4294967295, Integer between 0 and 4294967295, Integer between 0 and 65535 -> SourceSpan
  span-at (line) (col) (offset) (len) (fid) =
   let start = make-position line col offset
   in let stop = make-position line (col + len) (offset + len)
   in make-span start stop fid ProvParsed

  span-with-provenance : SourceSpan, Provenance -> SourceSpan
  span-with-provenance (span) (prov) =
   deck-record (SourceSpan {
    start = span.start,
    end = span.end,
    file-id = span.file-id,
    provenance = prov
   })

Section: Display
  span-display : SourceSpan, FileTable -> Text
  span-display (span) (table) =
   if is-synthetic-span span then ""
   else let name = file-table-name table (span.file-id)
    in (if name == "" then "" else name & ":")
       & integer-to-text (span.start.line) & ":" & integer-to-text (span.start.column)

