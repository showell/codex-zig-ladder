  p-cx_buf_write_byte : List Frag
  p-cx_buf_write_byte = [Lit "// variant-tag is the constructor's 0-based declaration index: bare\n// metal loads word 0 of the variant block (emit-variant-tag-builtin) and\n// writes find-ctor-tag there, and a union(enum)'s tag is numbered the same\n// way by declaration order. Self-recursive variants are pointers here, so\n// the pointer case dereferences first.\nfn cx_vtag(v: anytype) i64 {\n    return switch (@typeInfo(@TypeOf(v))) {\n        .pointer => @intCast(@intFromEnum(v.*)),\n        else => @intCast(@intFromEnum(v)),\n    };\n}\nfn ", Use "cx_buf_write_byte", Lit "(b: i64, off: i64, v: i64) i64 {\n    ", Use "cx_buf_want", Lit "(b + off + 1);\n    ", Use "cx_heap_mem", Lit "[@intCast(b + off)] = @intCast(@mod(v, 256));\n    return off + 1;\n}\n"]

  p-cx_buf_write_bytes : List Frag
  p-cx_buf_write_bytes = [Lit "fn ", Use "cx_buf_write_bytes", Lit "(b: i64, off: i64, vs: anytype) i64 {\n    const n: i64 = @intCast(vs.items.items.len);\n    ", Use "cx_buf_want", Lit "(b + off + n);\n    for (vs.items.items, 0..) |v, i| ", Use "cx_heap_mem", Lit "[@as(usize, @intCast(b + off)) + i] = @intCast(@mod(v, 256));\n    return off + n;\n}\n"]

  p-cx_peek_byte : List Frag
  p-cx_peek_byte = [Lit "fn ", Use "cx_peek_byte", Lit "(b: i64, off: i64) i64 {\n    ", Use "cx_buf_want", Lit "(b + off + 1);\n    return ", Use "cx_heap_mem", Lit "[@intCast(b + off)];\n}\n"]

  p-cx_buf_read_bytes : List Frag
  p-cx_buf_read_bytes = [Lit "fn ", Use "cx_buf_read_bytes", Lit "(b: i64, off: i64, n: i64) *", Use "CxList", Lit "(i64) {\n    ", Use "cx_buf_want", Lit "(b + off + n);\n    const l = ", Use "cx_ll_empty", Lit "(i64);\n    l.items.ensureTotalCapacity(", Use "cx_gpa", Lit ", @intCast(n)) catch @panic(\"oom\");\n    var cx_j: i64 = 0;\n    while (cx_j < n) : (cx_j += 1) l.items.appendAssumeCapacity(", Use "cx_heap_mem", Lit "[@as(usize, @intCast(b + off + cx_j))]);\n    return l;\n}\n"]

  p-cx_shru : List Frag
  p-cx_shru = [Lit "fn ", Use "cx_shru", Lit "(a: i64, b: i64) i64 {\n    return @bitCast(@as(u64, @bitCast(a)) >> @as(u6, @intCast(b & 63)));\n}\n"]

  p-cx_mod : List Frag
  p-cx_mod = [Lit "// int-mod is Euclidean, so the result lands in [0, |b|) regardless of\n// either sign, where @rem takes the dividend's sign.\nfn ", Use "cx_mod", Lit "(a: i64, b: i64) i64 {\n    const m = if (b < 0) -b else b;\n    const r = @rem(a, m);\n    return if (r < 0) r + m else r;\n}\n"]

  p-cx_text_eq : List Frag
  p-cx_text_eq = [Lit "fn ", Use "cx_text_eq", Lit "(a: []const u8, b: []const u8) bool {\n    return ", Use "std", Lit ".mem.eql(u8, a, b);\n}\n"]

  p-cx_is_letter : List Frag
  p-cx_is_letter = [Lit "// Classification is banded in CCE: 13..64 are the ASCII letters, 65..96\n// the punctuation between, 97..127 the accented Latin and Cyrillic\n// letters, 3..12 the digits -- the same two-band test bare metal's\n// emit-is-letter-builtin encodes.\nfn ", Use "cx_is_letter", Lit "(c: i64) bool {\n    return (c >= 13 and c <= 64) or (c >= 97 and c <= 127);\n}\n"]

  p-cx_is_digit : List Frag
  p-cx_is_digit = [Lit "fn ", Use "cx_is_digit", Lit "(c: i64) bool {\n    return c >= 3 and c <= 12;\n}\n"]

  p-cx_new : List Frag
  p-cx_new = [Lit "fn ", Use "cx_new", Lit "(v: anytype) *@TypeOf(v) {\n    const p = ", Use "cx_gpa", Lit ".create(@TypeOf(v)) catch @panic(\"oom\");\n    p.* = v;\n    return p;\n}\n"]

  p-cx_concat : List Frag
  p-cx_concat = [Lit "// An accumulator loop appends to the frontier block, and the bytes\n// just past it are free. Growing there leaves every existing holder of\n// `a` seeing the same bytes -- text is immutable and nothing before\n// a.len is written -- so the loop costs n instead of n(n+1)/2. Bare\n// metal reaches the same asymptotics from the other side, statically:\n// is-inplace-append (X86_64.codex:2376) recognises a tail-recursive\n// accumulator parameter and calls __str_concat_inplace. That analysis\n// needs TCO state this emitter does not track, and it does not need to:\n// on a bump frontier the same question is one pointer comparison at run\n// time. Measured 2026-08-21 with findings/probe-memory-model.codex,\n// text accumulation at n = 64/128/256: 2080/8256/32896 bytes before\n// (exactly n(n+1)/2), 64/128/256 after, against bare metal 72/136/264.\n// No empty short-circuit. `a & \"\"` returning `a` is the finding-29 shape:\n// bare metal has no such case -- both emit-str-concat-fast-bump and\n// emit-str-concat-slow-alloc bump r10 unconditionally, so the result is\n// always a fresh block at the live cursor -- and an aliased return inside a\n// deck extent yields a value that looks decked and is not. Falling through\n// costs an empty allocation and buys the guarantee.\nfn ", Use "cx_concat", Lit "(a: []const u8, b: []const u8) []const u8 {\n    if (a.len != 0) {\n        const cx_base = @intFromPtr(cx_heap_base());\n        const cx_ap = @intFromPtr(a.ptr);\n        if (cx_ap >= cx_base and cx_ap - cx_base + a.len == @as(usize, @intCast(", Use "cx_hp", Lit "))) {\n            const cx_tail = ", Use "cx_gpa", Lit ".alloc(u8, b.len) catch @panic(\"oom\");\n            @memcpy(cx_tail, b);\n            return a.ptr[0 .. a.len + b.len];\n        }\n    }\n    return ", Use "std", Lit ".mem.concat(", Use "cx_gpa", Lit ", u8, &.{ a, b }) catch @panic(\"oom\");\n}\n"]

