  p-cx_read_file_uni : List Frag
  p-cx_read_file_uni = [Lit "// The I/O boundary. Codex text is CCE everywhere inside -- on bare metal\n// and here alike -- so these convert at the edge and nowhere else: bytes\n// arriving become CCE, bytes leaving are already what they are. std.fs in\n// 0.16 wants an Io the generated main has no reason to carry, so this uses\n// the raw syscalls.\nfn cx_utf8_to_cce(bytes: []const u8) []const u8 {\n    var out: ", Use "std", Lit ".ArrayListUnmanaged(u8) = .empty;\n    var i: usize = 0;\n    while (i < bytes.len) {\n        const n = ", Use "std", Lit ".unicode.utf8ByteSequenceLength(bytes[i]) catch @panic(\"cx_utf8_to_cce: bad utf8\");\n        const cp = ", Use "std", Lit ".unicode.utf8Decode(bytes[i..][0..n]) catch @panic(\"cx_utf8_to_cce: bad utf8\");\n        ", Use "cx_cce_frame", Lit "(", Use "cx_cp_to_cce", Lit "(cp), &out);\n        i += n;\n    }\n    return out.items;\n}\nfn ", Use "cx_read_file_uni", Lit "(path_cce: []const u8) []const u8 {\n    const al = ", Use "cx_gpa", Lit ";\n    const path = ", Use "cx_cce_to_utf8", Lit "(path_cce);\n    const z = al.allocSentinel(u8, path.len, 0) catch @panic(\"oom\");\n    @memcpy(z, path);\n    const rc = ", Use "std", Lit ".os.linux.openat(-100, z.ptr, .{ .ACCMODE = .RDONLY }, 0);\n    if (@as(isize, @bitCast(rc)) < 0) @panic(\"cx_read_file_uni: cannot open\");\n    const fd: i32 = @intCast(rc);\n    defer _ = ", Use "std", Lit ".os.linux.close(fd);\n    var raw: ", Use "std", Lit ".ArrayListUnmanaged(u8) = .empty;\n    var chunk: [65536]u8 = undefined;\n    while (true) {\n        const n = ", Use "std", Lit ".os.linux.read(fd, &chunk, chunk.len);\n        if (@as(isize, @bitCast(n)) < 0) @panic(\"cx_read_file_uni: read failed\");\n        if (n == 0) break;\n        raw.appendSlice(al, chunk[0..n]) catch @panic(\"oom\");\n    }\n    return cx_utf8_to_cce(raw.items);\n}\n"]

  p-cx_write_all : List Frag
  p-cx_write_all = [Lit "fn ", Use "cx_write_all", Lit "(bytes: []const u8) void {\n    var off: usize = 0;\n    while (off < bytes.len) {\n        const n = ", Use "std", Lit ".os.linux.write(1, bytes.ptr + off, bytes.len - off);\n        if (@as(isize, @bitCast(n)) <= 0) @panic(\"cx_write_all: write failed\");\n        off += n;\n    }\n}\n"]

