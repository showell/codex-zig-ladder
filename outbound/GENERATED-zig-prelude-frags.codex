  p-cx_deck_best = [Lit "var ", Use "cx_deck_best", Lit ": i64 = 0;\n"]

  p-cx_deck_stride : List Frag
  p-cx_deck_stride = [Lit "var ", Use "cx_deck_stride", Lit ": i64 = 0;\n"]

  p-cx_deck_armed : List Frag
  p-cx_deck_armed = [Lit "var ", Use "cx_deck_armed", Lit ": bool = false;\n"]

  p-cx_deck_slack : List Frag
  p-cx_deck_slack = [Lit "// Measurement-only headroom, added to the lift that follows __deck-set so\n// the deck can run PAST its reservation without meeting the main frontier.\n// Zero in every normal build, and it must stay zero in anything banked: it\n// changes __deck-pos, which the depot can observe. The point of it is that the\n// guard fires at the FIRST crossing, and a first crossing tells you only that\n// demand exceeded the reservation -- the deficit it reports is bounded by one\n// allocation and is therefore always about zero. Slack lets the program finish\n// so the TRUE peak is knowable.\nconst ", Use "cx_deck_slack", Lit ": i64 = 0;\n"]

  p-cx_deck_report : List Frag
  p-cx_deck_report = [Lit "// STDOUT, never stderr. stderr carries the program's output and every\n// comparison in the ladder diffs it, so a measurement written there would\n// corrupt the thing being measured. Raw write syscall rather than\n// std.Io.File, which in 0.16 wants an Io instance. Only on a new peak, so the\n// lines are few and the last one is the answer.\nfn ", Use "cx_deck_report", Lit "() void {\n    if (@import(\"builtin\").os.tag != .linux) return;\n    if (", Use "cx_deck_base", Lit " == 0 or ", Use "cx_deck_top", Lit " == 0) return;\n    const cx_used = ", Use "cx_deck_hw", Lit " - ", Use "cx_deck_base", Lit ";\n    if (cx_used - ", Use "cx_deck_stride", Lit " < 1048576) return;\n    ", Use "cx_deck_stride", Lit " = cx_used;\n    var cx_b: [224]u8 = undefined;\n    const cx_s = ", Use "std", Lit ".fmt.bufPrint(&cx_b, \"CX-DECK used={d} reserved={d} headroom={d} base={d} peak={d} best={d}\\n\", .{ cx_used, ", Use "cx_deck_top", Lit " - ", Use "cx_deck_base", Lit ", ", Use "cx_deck_top", Lit " - ", Use "cx_deck_hw", Lit ", ", Use "cx_deck_base", Lit ", ", Use "cx_deck_hw", Lit ", ", Use "cx_deck_best", Lit " }) catch return;\n    _ = ", Use "std", Lit ".os.linux.write(1, cx_s.ptr, cx_s.len);\n}\n"]

  p-cx_deck_enter : List Frag
  p-cx_deck_enter = [Lit "fn ", Use "cx_deck_enter", Lit "() i64 {\n    if (", Use "cx_nest", Lit " == 0) {\n        ", Use "cx_bivy", Lit " = ", Use "cx_hp", Lit ";\n        ", Use "cx_hp", Lit " = ", Use "cx_dptr", Lit ";\n    }\n    ", Use "cx_nest", Lit " += 1;\n    return 0;\n}\n"]

  p-cx_deck_exit : List Frag
  p-cx_deck_exit = [Lit "fn ", Use "cx_deck_exit", Lit "() i64 {\n    ", Use "cx_nest", Lit " -= 1;\n    if (", Use "cx_nest", Lit " == 0) {\n        ", Use "cx_dptr", Lit " = ", Use "cx_hp", Lit ";\n        ", Use "cx_hp", Lit " = ", Use "cx_bivy", Lit ";\n        ", Use "cx_deck_report", Lit "();\n    }\n    return 0;\n}\n"]

  p-cx_deck_pos : List Frag
