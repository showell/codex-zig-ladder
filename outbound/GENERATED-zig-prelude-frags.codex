  p-std : List Frag
  p-std = [Lit "const ", Use "std", Lit " = @import(\"std\");\n\n"]

  p-CxFn1 : List Frag
  p-CxFn1 = [Lit "// cx_gpa and the heap it allocates from live beside the buffer\n// builtins below: one region, one bump frontier, bare metal's model.\n\nfn ", Use "CxFn1", Lit "(comptime A: type, comptime R: type) type {\n    return struct { ctx: *anyopaque, call: *const fn (*anyopaque, A) R };\n}\n"]

