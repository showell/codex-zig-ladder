Chapter: ProbeShake
  cites Foreword chapter Console
  cites Foreword chapter Shake

 The fixtures for `Foreword chapter Shake`, which is the tree-shaking closure
 with no target in it.

 THIS FILE DEFINES NO ALGORITHM. It cites the same chapter ZigEmitter cites,
 so what is tested here is what runs there -- not a second copy that agrees
 today. Two mechanisms for one concept is the failure this arrangement exists
 to prevent, and the emitter's own notes already record it happening twice.

 It is a tier, so it runs on bare metal and through the plug and the two must
 agree: the closure gets the double-compiling treatment rather than being
 trusted.

 FIXTURE 8 IS THE ONE THAT MATTERS AND ITS FIRST VERSION WAS DECORATION. It
 was written as [Z, Y, X] with X depending on Y depending on Z -- where the
 table order and a dependencies-first topological order are BOTH "Z Y X", so
 it could not tell them apart and would have passed either implementation. It
 is now [X, Y, Z], where the two orders differ. A fixture that cannot fail the
 thing it is named after is decoration.

 FIXTURE 12 IS WHY FRAGMENTS BEAT SCANNING. Its text mentions `cx_ghost` and
 its uses do not include it, because the name sits in a `ShakeLit`. No scanner
 can reach that answer: it sees a name and must assume the worst, and that
 imprecision cascades -- false edges near the root drag whole subtrees behind
 them.

Section: Instrument

  mk : Text, List Text -> ShakePart
  mk (n) (ns) = ShakePart { name = n, frags = mk-uses ns 0 [] }

 A part built from bare dependency names, for the fixtures that care about the
 graph rather than the text.

  mk-uses : List Text, Integer, List ShakeFrag -> List ShakeFrag
  mk-uses (ns) (i) (acc) =
   if i >= list-length ns then acc
   else mk-uses ns (i + 1) (acc & [ShakeUse (list-at ns i)])

  names-of : List ShakePart -> List Text
  names-of (ps) = names-of-loop ps 0 []

  names-of-loop : List ShakePart, Integer, List Text -> List Text
  names-of-loop (ps) (i) (acc) =
   if i >= list-length ps then acc
   else names-of-loop ps (i + 1) (acc & [(list-at ps i).name])

  join : List Text -> Text
  join (xs) = if list-length xs == 0 then "(none)" else join-loop xs 0 ""

  join-loop : List Text, Integer, Text -> Text
  join-loop (xs) (i) (acc) =
   if i >= list-length xs then acc
   else if i == 0 then join-loop xs (i + 1) (list-at xs i)
   else join-loop xs (i + 1) (acc & " " & list-at xs i)

  report : Text, List ShakePart, List Text -> Text
  report (label) (ps) (roots) =
   label & ": kept [" & join (names-of (shake-kept ps roots))
   & "] unmatched [" & join (shake-unmatched ps roots) & "]"

Section: Main

  opening : [Console] Nothing = act
   let chain = [mk "A" ["B"], mk "B" ["C"], mk "C" []]
   in print-line-uni (report "1 chain      " chain ["A"])
   let diamond = [mk "A" ["B", "C"], mk "B" ["D"], mk "C" ["D"], mk "D" []]
   in print-line-uni (report "2 diamond   " diamond ["A"])
   let cyclic = [mk "A" ["B"], mk "B" ["A"]]
   in print-line-uni (report "3 cycle     " cyclic ["A"])
   let island = [mk "A" ["B"], mk "B" [], mk "C" ["D"], mk "D" []]
   in print-line-uni (report "4 island    " island ["A"])
   let two = [mk "A" ["B"], mk "B" []]
   in act
     print-line-uni (report "5 no roots  " two [])
     print-line-uni (report "6 unknown   " two ["nope"])
     print-line-uni (report "7 identity  " two ["A", "B"])
   end
   let ordered = [mk "X" ["Y"], mk "Y" ["Z"], mk "Z" []]
   in print-line-uni (report "8 order kept" ordered ["X"])
   let dup = [mk "A" ["B"], mk "B" []]
   in print-line-uni (report "9 dup roots " dup ["A", "A", "B"])
   let f1 = [ShakeLit "fn a() { ", ShakeUse "b", ShakeLit "(); }"]
   in act
     print-line-uni ("10 projection: text [" & shake-frag-text f1 & "]")
     print-line-uni ("11 uses      : [" & join (shake-frag-uses "a" f1) & "]")
   end
   let f2 = [ShakeLit "fn a() { cx_ghost(); ", ShakeUse "b", ShakeLit "(); }"]
   in print-line-uni ("12 lit is not a use: text mentions cx_ghost, uses [" & join (shake-frag-uses "a" f2) & "]")
   let f3 = [ShakeUse "b", ShakeLit " and ", ShakeUse "b", ShakeLit " again"]
   in print-line-uni ("13 use dedup : [" & join (shake-frag-uses "a" f3) & "]")
   let f4 = [ShakeLit "fn a() { ", ShakeUse "a", ShakeLit "(); }"]
   in print-line-uni ("14 self-edge dropped: [" & join (shake-frag-uses "a" f4) & "]")
   let real = [ShakePart { name = "A", frags = f1 }, mk "b" []]
   in act
     print-line-uni (report "15 closure over frags" real ["A"])
     print-line-uni ("16 shake-text: [" & shake-text real ["A"] & "]")
   end
  end
